[Desktop Entry]
Name=Lumina Reader
Comment=Modern, versatile eBook and document reader with native Fluent aesthetics
Exec=lumina-reader %F
Icon=lumina-reader
Terminal=false
Type=Application
Categories=Office;Viewer;Literature;
MimeType=application/epub+zip;application/pdf;application/vnd.comicbook+zip;application/vnd.comicbook-rar;
StartupNotify=true
